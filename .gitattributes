# Normalize text files and help GitHub linguist classify repository content

* text=auto

# Shell scripts
*.sh text eol=lf linguist-language=Shell

# Config and data files
*.conf text eol=lf
*.desktop text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.mailmap text eol=lf
.editorconfig text eol=lf
LICENSE text eol=lf

# Images and binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text
